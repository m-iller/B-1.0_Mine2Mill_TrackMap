MOMPS_ENV=development
MOMPS_API_SECRET=change-me-use-long-random-string
MOMPS_JWT_SECRET=change-me-jwt-secret
MOMPS_DATABASE_URL=postgresql+asyncpg://momps:momps_dev@localhost:5432/momps
MOMPS_INFLUX_URL=http://localhost:8086
MOMPS_INFLUX_TOKEN=momps-dev-token-replace-in-prod
MOMPS_INFLUX_ORG=momps
MOMPS_INFLUX_BUCKET=telemetry
MOMPS_RABBIT_URL=amqp://momps:momps_dev@localhost:5672/
MOMPS_BROKER_BACKEND=rabbitmq
MOMPS_FEATURE_CLOUD_SYNC=false
MOMPS_FEATURE_CV_HOOK=false
MOMPS_SIM_TICK_SECONDS=2
